{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "rekabet/insight-saas",
  "type": "project",
  "description": "AI destekli, organizasyon izoleli rakip analiz SaaS platformu.",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^2.10",
    "dompdf/dompdf": "^3.1",
    "symfony/dom-crawler": "^8.0",
    "symfony/css-selector": "^8.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php artisan test", "analyse": "phpstan analyse", "format": "pint"},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable", "prefer-stable": true
}
